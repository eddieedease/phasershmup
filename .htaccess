# Never serve a stale index.html — it references game.js with a cache-busting
# timestamp, so as long as the HTML is fresh, players get the latest build.
# Heavy static files (phaser.min.js, assets) keep normal caching for fast loads.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>
